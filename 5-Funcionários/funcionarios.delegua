            "salario":2450.00,
            "area":"SD"
        },
        {
            "id":3,
            "nome":"Bernardo",
            "sobrenome":"Costa",
            "salario":3700.00,
            "area":"SM"
        },
        {
            "id":4,
            "nome":"Cleverton",
            "sobrenome":"Farias",
            "salario":2750.00,
            "area":"SD"
        },
        {
            "id":5,
            "nome":"Abraão",
            "sobrenome":"Campos",
            "salario":2550.00,
            "area":"SD"
        },
        {
            "id":6,
            "nome":"Letícia",
            "sobrenome":"Farias",
            "salario":2450.00,
            "area":"UD"
        },
        {
            "id":7,
            "nome":"Fernando",
            "sobrenome":"Ramos",
            "salario":2450.00,
            "area":"SD"
        },
        {
            "id":8,
            "nome":"Marcelo",
            "sobrenome":"Farias",
            "salario":2550.00,
            "area":"UD"
        },
        {
            "id":9,
            "nome":"Fabio",
            "sobrenome":"Souza",
            "salario":2750.00,
            "area":"SD"
        },
        {
            "id":10,
            "nome":"Clederson",
            "sobrenome":"Oliveira",
            "salario":2500.00,
            "area":"SD"
        }
    ],
    "areas":[
        {
            "codigo":"SD",
            "nome":"Desenvolvimento de Software"
        },
        {
            "codigo":"SM",
            "nome":"Gerenciamento de Software"
        },
        {
            "codigo":"UD",
            "nome":"Designer de UI/UX"
        }
    ]
}

var maiorSalario = 0
var menorSalario = 1000000

var funcionariosMaioresSalarios = []
var funcionariosMenoresSalarios = []

var numeroTotalFuncionarios = 0
var somaSalarios = 0

para cada funcionario em dados.funcionarios {
    somaSalarios += funcionario.salario
    numeroTotalFuncionarios = numeroTotalFuncionarios + 1

    se funcionario.salario >= maiorSalario {
        maiorSalario = funcionario.salario
        funcionariosMaioresSalarios.adicionar(funcionario)
    }

    se funcionario.salario <= menorSalario {
        menorSalario = funcionario.salario
        funcionariosMenoresSalarios.adicionar(funcionario)
    }
}

para cada funcionario em funcionariosMaioresSalarios {
    se funcionario.salario == maiorSalario {
        escreva("global_max|${funcionario.nome} ${funcionario.sobrenome}|${maiorSalario}")
    }
}

para cada funcionario em funcionariosMenoresSalarios {
    se funcionario.salario == menorSalario {
        escreva("global_min|${funcionario.nome} ${funcionario.sobrenome}|${menorSalario}")
    }
}

var mediaSalarios = somaSalarios / numeroTotalFuncionarios
escreva("global_avg|${mediaSalarios.formatar()}")

var gruposAreas = {}

para cada area em dados.areas {
    gruposAreas[area.codigo] = {
        "nome": area.nome,
        "salarioMaximo": 0,
        "salarioMinimo": 1000000,
        "mediaSalarios": 0,
        "totalFuncionarios": 0,
        "totalSalarios": 0,
        "funcionariosMaioresSalarios": [],
        "funcionariosMenoresSalarios": []
    }
}

para cada funcionario em dados.funcionarios {
    var area = gruposAreas[funcionario.area]
    area.totalFuncionarios += 1
    area.totalSalarios += funcionario.salario

    se area.salarioMaximo <= funcionario.salario {
        area.salarioMaximo = funcionario.salario
        area.funcionariosMaioresSalarios.adicionar(funcionario)
    }

    se area.salarioMinimo >= funcionario.salario {
        area.salarioMinimo = funcionario.salario
        area.funcionariosMenoresSalarios.adicionar(funcionario)
    }
}

para cada {codigoArea, area} em gruposAreas {
    area.mediaSalarios = area.totalSalarios / area.totalFuncionarios

    para cada funcionario em area.funcionariosMaioresSalarios {
        se funcionario.salario == area.salarioMaximo {
            escreva("area_max|${area.nome}|${funcionario.nome} ${funcionario.sobrenome}|${area.salarioMaximo}")
        }
    }

    para cada funcionario em area.funcionariosMenoresSalarios {
        se funcionario.salario == area.salarioMinimo {
            escreva("area_min|${area.nome}|${funcionario.nome} ${funcionario.sobrenome}|${area.salarioMinimo}")
        }
    }

    escreva("area_avg|${area.nome}|${area.mediaSalarios.formatar()}")
}

var areasMenosFuncionarios = []
var areasMaisFuncionarios = []

var areaMinimaFuncionarios = {
    'totalFuncionarios': 1000000
}

var areaMaximaFuncionarios = {
    'totalFuncionarios': 0
}

para cada {codigoArea, area} em gruposAreas {
    se areaMinimaFuncionarios.totalFuncionarios >= area.totalFuncionarios {
        areaMinimaFuncionarios = area
        areasMenosFuncionarios.adicionar(area)
    }

    se areaMaximaFuncionarios.totalFuncionarios <= area.totalFuncionarios {
        areaMaximaFuncionarios = area
        areasMaisFuncionarios.adicionar(area)
    }
}

para cada area em areasMenosFuncionarios {
    se area.totalFuncionarios == areaMinimaFuncionarios.totalFuncionarios {
        escreva("least_employees|${area.nome}|${area.totalFuncionarios}")
    }
}

para cada area em areasMaisFuncionarios {
    se area.totalFuncionarios == areaMaximaFuncionarios.totalFuncionarios {
        escreva("most_employees|${area.nome}|${area.totalFuncionarios}")
    }
}