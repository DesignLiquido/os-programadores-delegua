const json = importar('json')
const jsonFuncionarios = json.importarArquivoJson('./funcionarios.json')

var totalSalarios = 0
var numeroFuncionarios = 0
var pessoaSalarioMaximo = jsonFuncionarios.funcionarios[0]
var pessoaSalarioMinimo = jsonFuncionarios.funcionarios[0]

para cada funcionario em jsonFuncionarios.funcionarios {
    // escreva(funcionario)
    totalSalarios += funcionario.salario
    numeroFuncionarios += 1
    se funcionario.salario > pessoaSalarioMaximo.salario {
        pessoaSalarioMaximo = funcionario
    }

    se funcionario.salario < pessoaSalarioMinimo.salario {
        pessoaSalarioMinimo = funcionario
    }
}

escreva("Total de salários: ${totalSalarios}")
escreva("Total de funcionários: ${numeroFuncionarios}")

var mediaSalarial = totalSalarios / numeroFuncionarios
escreva("Média salarial: ${mediaSalarial}")

escreva("Pessoa com o maior salário: ${pessoaSalarioMaximo}")
escreva("Pessoa com o menor salário: ${pessoaSalarioMinimo}")

var analiticosAreas = {}

para cada area em jsonFuncionarios.areas {
    // escreva(area)
    analiticosAreas[area['codigo']] = {
        'codigo': area['codigo'],
        'nome': area['nome'],
        'pessoaSalarioMaximo': nulo,
        'pessoaSalarioMinimo': nulo,
        'mediaSalarial': 0,
        'totalSalarios': 0,
        'numeroFuncionarios': 0
    }
}

para cada funcionario em jsonFuncionarios.funcionarios {
    // escreva(funcionario)
    // var area = analiticosAreas[funcionario['area']]
    analiticosAreas[funcionario['area']].totalSalarios += funcionario.salario
    analiticosAreas[funcionario['area']].numeroFuncionarios += 1
    se analiticosAreas[funcionario['area']].pessoaSalarioMaximo == nulo ou funcionario.salario > analiticosAreas[funcionario['area']].pessoaSalarioMaximo.salario {
        analiticosAreas[funcionario['area']].pessoaSalarioMaximo = funcionario
    }

    se analiticosAreas[funcionario['area']].pessoaSalarioMinimo == nulo ou funcionario.salario < analiticosAreas[funcionario['area']].pessoaSalarioMinimo.salario {
        analiticosAreas[funcionario['area']].pessoaSalarioMinimo = funcionario
    }
}

// Cálculo das médias
