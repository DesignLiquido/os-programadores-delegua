var maiorSalario = 0
var menorSalario = 1000000

var funcionariosMaioresSalarios = []
var funcionariosMenoresSalarios = []

var numeroTotalFuncionarios = 0
var somaSalarios = 0

para cada funcionario em dados.funcionarios {
    somaSalarios += funcionario.salario
    numeroTotalFuncionarios = numeroTotalFuncionarios + 1

    se funcionario.salario >= maiorSalario {
        maiorSalario = funcionario.salario
        funcionariosMaioresSalarios.adicionar(funcionario)
    }

    se funcionario.salario <= menorSalario {
        menorSalario = funcionario.salario
        funcionariosMenoresSalarios.adicionar(funcionario)
    }
}

para cada funcionario em funcionariosMaioresSalarios {
    se funcionario.salario == maiorSalario {
        escreva("global_max|${funcionario.nome} ${funcionario.sobrenome}|${maiorSalario}")
    }
}

para cada funcionario em funcionariosMenoresSalarios {
    se funcionario.salario == menorSalario {
        escreva("global_min|${funcionario.nome} ${funcionario.sobrenome}|${menorSalario}")
    }
}

var mediaSalarios = somaSalarios / numeroTotalFuncionarios
escreva("global_avg|${mediaSalarios.formatar()}")
